# ===================================================================
# SkillBridge Environment Configuration
# ===================================================================

# Set to django.core.mail.backends.smtp.EmailBackend to send real emails
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Provider Settings (Default: Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Your Email and App Password
# For Gmail: Turn on 2-Step Verification -> Create an "App Password" (16 letters)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password

# Sender name and email shown in recipients' inbox
DEFAULT_FROM_EMAIL=SkillBridge <your_email@gmail.com>

# Site URL for clickable email verification links
SITE_URL=http://127.0.0.1:8000
